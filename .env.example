# DriftWatch — Environment Variables
# 1. Copy this file: cp .env.example .env
# 2. Get free Groq key at: https://console.groq.com (no credit card)
# 3. Paste your key below

GROQ_API_KEY=your_groq_api_key_here

# Models (do not change)
GROQ_MODEL=llama-3.1-70b-versatile
EMBED_MODEL=nomic-embed-text-v1.5

# Drift thresholds (calibrated for Groq nomic embeddings)
DRIFT_THRESHOLD_EXPLORE=0.30
DRIFT_THRESHOLD_EXPLOIT=0.40
DRIFT_THRESHOLD_CONCLUDE=0.50

# Dashboard
DASHBOARD_PORT=5000
